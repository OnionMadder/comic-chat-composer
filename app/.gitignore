# Node
node_modules/

# Capacitor / Android build artifacts (the android/ project itself is kept)
android/.gradle/
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/
android/local.properties
*.keystore
*.jks
# Points at the upload key and holds its passwords. Never commit this — see the
